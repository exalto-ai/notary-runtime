{
  "name": "@exalto/notary-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test:browser": "vitest run --config vitest.config.ts",
    "prepare:sidecar:debug": "node scripts/prepare-sidecar.mjs debug",
    "prepare:sidecar:release": "node scripts/prepare-sidecar.mjs release",
    "tauri:dev": "npm run prepare:sidecar:debug && tauri dev",
    "tauri:build:debug": "npm run prepare:sidecar:debug && tauri build --debug --bundles app",
    "tauri:build": "npm run prepare:sidecar:release && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "lucide-react": "^0.539.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.10"
  }
}
