{
  "name": "@exalto/notary-admin-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check",
    "check": "npm run check:frontend && npm run check:types",
    "check:frontend": "biome check .",
    "check:types": "tsc --noEmit",
    "format": "biome check --write .",
    "build": "npm run check:frontend && npm run check:api && npm run check:types && vite build",
    "capture:dashboard-docs": "node scripts/capture-dashboard-docs.mjs",
    "check:local-docs": "node scripts/check-local-docs.mjs",
    "test": "vitest run --config vitest.config.js",
    "preview": "vite preview --outDir ../../crates/notaryd/dashboard --host 127.0.0.1"
  },
  "dependencies": {
    "@mantine/core": "^9.5.0",
    "@mantine/hooks": "^9.5.0",
    "@mantine/notifications": "^9.5.0",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^6.0.5",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.10",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.62.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
