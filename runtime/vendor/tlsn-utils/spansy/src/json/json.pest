//! A parser for JSON file.
//!
//! And this is a example for JSON parser.
json = _{ SOI ~ value ~ eoi }
eoi = _{ !ANY }

/// Matches object, e.g.: `{ "foo": "bar" }`
/// Foobar
object = { "{" ~ (pair ~ ("," ~ pair)*)? ~ "}" }
pair   = { quoted_string ~ ":" ~ value }

array = { "[" ~ (value ~ ("," ~ value)*)? ~ "]" }

//////////////////////
/// Matches value, e.g.: `"foo"`, `42`, `true`, `null`, `[]`, `{}`.
//////////////////////
value = _{ quoted_string | number | object | array | bool | null }

quoted_string  = _{ "\"" ~ string ~ "\"" }
// LOCAL PATCH (see vendor/tlsn-utils/README.md): upstream parsed strings with
// `string = @{ (!("\"" | "\\") ~ ANY)* ~ (escape ~ string)? }`, which is
// right-recursive and consumes one parser stack frame per escape sequence.
// Escape-dense strings (typical LLM prompts with thousands of `\n` and `\"`
// sequences) overflowed the client runtime stack. This iterative form matches
// exactly the same strings with constant stack usage.
string   = @{ ((!("\"" | "\\") ~ ANY) | escape)* }
escape  = @{ "\\" ~ ("\"" | "\\" | "/" | "b" | "f" | "n" | "r" | "t" | unicode) }
unicode = @{ "u" ~ ASCII_HEX_DIGIT{4} }

number = @{ "-"? ~ int ~ ("." ~ ASCII_DIGIT+ ~ exp? | exp)? }
int    = @{ "0" | ASCII_NONZERO_DIGIT ~ ASCII_DIGIT* }
exp    = @{ ("E" | "e") ~ ("+" | "-")? ~ ASCII_DIGIT+ }

bool = { "true" | "false" }

null = { "null" }

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
